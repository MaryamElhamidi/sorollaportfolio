---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{webp,jpg,png,gif}"
);
---

<section class="py-50 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0 self-center max-w-6xl mx-auto">
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <h1 class="text-pblack text-3xl md:text-4xl">Website still under construction</h1>
    <p class="text-7xl md:text-8xl font-bold">
      Hi, I am <span class="highlight-marker">Maryam</span>
    </p>
    <p class="text-lg md:text-xl">
      I am a Computer Science student specializing in Data Analytics and interested in Summer 2026 Internships.
    </p>
    <a
      rel="noopener noreferrer"
      target="_blank"
      class="bg-pgreen px-6 py-4 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition text-lg md:text-xl"
    >
      Contact Me!
    </a>
  </div>

  <div class="md:w-1/2 flex items-center justify-end p-10 group">
    <a
      rel="noopener noreferrer"
      href="https://www.linkedin.com/in/maryamelhamidi/"
      target="_blank"
    >

        <div
          class="bg-pblue border-3 border-black rounded-2xl h-64 w-72 md:h-80 md:w-80 shadow-card group-hover:shadow-hover flex transition relative"
        >
        <div
          class="absolute -top-10 -left-14 text-6xl bg-ppink px-6 py-2 z-10 shadow-card group-hover:shadow-hover transition rounded-t-2xl border-3 border-black rounded-bl-2xl rounded-br-sm"
        >
          <Icon name="paint" />
        </div>
        <div
          class="absolute top-20 -right-20 text-6xl bg-pyellow p-3 z-10 shadow-card group-hover:shadow-hover transition rounded-full border-3 border-black"
        >
          <Icon name="beach" />
        </div>
        <div
          class="absolute flex items-center gap-4 -bottom-16 right-0 pr-4 bg-pgreen pl-2 z-10 shadow-card1 group-hover:shadow-card transition rounded-full border-3 border-black"
        >
          <Icon name="beach" />
          <p>Maryam Elhamidi</p>
        </div>
        <div class="h-96 w-72 md:h-[28rem] md:w-80 overflow-hidden relative -mt-32 rounded-2xl">
          <Image
            class="object-bottom absolute bottom-0 group-hover:scale-105 transition"
            src={images["/src/assets/hero.webp"]()}
            alt="Maryam, photo wiki"
          />
        </div>
      </div>
    </a>
  </div>
</section>
