---
---
<div id="loader" class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-white transition-opacity duration-1000">
  <div class="flex flex-col items-center gap-6">
    <!-- Pixel Buddy -->
    <img 
      src="/icons/pixel-buddy.png" 
      alt="Loading..." 
      class="w-32 h-32 pixel-art animate-float" 
    />
    
    <!-- Text and Percentage -->
    <div class="flex flex-col items-center gap-2">
      <p class="text-2xl font-bold text-pblack font-kablamo">Loading...</p>
      <p id="progress-text" class="text-3xl font-bold text-ppink font-kablamo">0%</p>
    </div>

    <!-- Progress Bar -->
    <div class="w-64 h-6 bg-gray-100 rounded-full overflow-hidden border-2 border-black shadow-card">
      <div id="progress-bar" class="h-full bg-pgreen transition-all duration-300 w-0 border-r-2 border-black"></div>
    </div>
  </div>
</div>

<style>
  .pixel-art {
    image-rendering: pixelated;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>

<script>
  const loader = document.getElementById('loader');
  const progressText = document.getElementById('progress-text');
  const progressBar = document.getElementById('progress-bar');
  const heroImage = document.getElementById('hero-image');

  let progress = 0;
  // Track if window load and image load are done
  let windowLoaded = false;
  let imageLoaded = false;
  
  // Artificial progress increment
  const interval = setInterval(() => {
    // Slow down as we get closer to 90%
    const increment = progress < 50 ? Math.random() * 5 : Math.random() * 2;
    
    if (progress + increment < 90) {
      progress += increment;
      updateUI();
    }
  }, 200);

  function updateUI() {
    if (progressText) progressText.innerText = Math.floor(progress) + '%';
    if (progressBar) progressBar.style.width = progress + '%';
  }

  function checkAllLoaded() {
    // Only finish if both window is ready and image (if it exists) is loaded
    if (windowLoaded && imageLoaded) {
      finishLoading();
    }
  }

  function finishLoading() {
    clearInterval(interval);
    progress = 100;
    updateUI();
    
    // Give a small moment to see 100% then fade out
    setTimeout(() => {
      if (loader) {
        loader.classList.add('opacity-0', 'pointer-events-none');
        // Remove from DOM after fade out
        setTimeout(() => {
          loader.remove();
        }, 1000);
      }
    }, 500); 
  }

  // Check image status helper
  function markImageLoaded() {
    imageLoaded = true;
    checkAllLoaded();
  }

  // Window load listener
  window.addEventListener('load', () => {
    windowLoaded = true;
    
    // Double check image status immediately after window load
    // in case it finished right then or was cached
    if (!heroImage) {
        // If no hero image on this page, just mark true
        imageLoaded = true;
    } else if (heroImage.complete) {
        imageLoaded = true;
    }
    
    checkAllLoaded();
  });

  // Specific Image Listener setup
  if (heroImage) {
    if (heroImage.complete) {
      markImageLoaded();
    } else {
      heroImage.addEventListener('load', markImageLoaded);
      heroImage.addEventListener('error', markImageLoaded); // Proceed on error
    }
  } else {
    // No hero image? treat as loaded
    markImageLoaded();
  }
</script>
