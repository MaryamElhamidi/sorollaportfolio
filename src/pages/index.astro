---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Hero from "@/components/Hero.astro";
import WhatIDo from "@/components/WhatIDo.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body class="relative min-h-screen overflow-hidden p-0 m-0 max-w-screen">

    <!-- Background animation layer -->
    <div id="bg-container" class="bg-layer"></div>

    <!-- Foreground content layer -->
    <div class="content-layer">
      <Header />

      <main class="container mx-auto md:px-10">
        <Hero />
        <WhatIDo />
      </main>

      <Footer />
    </div>

    <!-- Optional debug button -->
    <button class="randomise fixed bottom-4 right-4 z-20" onclick="drawBg()">
      Randomise
    </button>

    <!-- Background script -->
    <script src="/src/scripts/background.js" defer></script>

  </body>
</html>
