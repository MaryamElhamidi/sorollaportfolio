---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/hero.webp";

const title = "About Me";
const description = "Data Analytics & CS Student transforming raw data into actionable insights.";
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-white text-black font-sans selection:bg-ppink selection:text-white">
    <Header />
    
    <main class="w-full">
      <!-- Hero Section -->
      <section class="relative w-full h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden">
         <div class="absolute inset-0 z-0">
            <Image 
              src={heroImage} 
              alt="Maryam Elhamidi" 
              class="w-full h-full object-cover opacity-90"
            />
            <div class="absolute inset-0 bg-black/40"></div>
         </div>
         <div class="relative z-10 text-center text-white px-6 animate-fade-in-up">
            <h1 class="text-5xl md:text-7xl font-bold mb-4 font-kablamo text-shadow-lg text-ppink">About Me</h1>
            <p class="text-xl md:text-2xl font-light max-w-2xl mx-auto text-shadow">
              Data Analytics & CS Student transforming raw data into <span class="font-semibold text-pgreen">actionable insights</span>.
            </p>
         </div>
      </section>

      <!-- Content Container -->
      <div class="container mx-auto px-6 py-16 md:py-24 max-w-4xl flex flex-col gap-20">

        <!-- The Hook -->
        <section class="grid md:grid-cols-12 gap-8 items-start">
            <div class="md:col-span-4">
               <h2 class="text-3xl font-bold border-b-4 border-pgreen inline-block pb-2">My Story</h2>
            </div>
            <div class="md:col-span-8 text-lg leading-relaxed text-gray-800">
               <p>
                  I am a Computer Science student specializing in Data Analytics with a passion for transforming raw data into actionable insights. Whether it's helping businesses understand underserved communities or building healthcare platforms, I focus on creating tech that matters. 
               </p>
               <br/>
               <p class="font-medium text-black">
                  I don't just write code; I build tools that solve specific societal or business problems.
               </p>
            </div>
        </section>

        <!-- Big Wins -->
        <section class="grid md:grid-cols-12 gap-8 items-start">
            <div class="md:col-span-4">
               <h2 class="text-3xl font-bold border-b-4 border-ppink inline-block pb-2">Big Wins</h2>
            </div>
            <div class="md:col-span-8 space-y-8">
               
               <div class="p-6 bg-gray-50 rounded-xl border border-gray-100 hover:shadow-lg transition duration-300">
                  <h3 class="text-xl font-bold mb-2 text-pblue">TrueNorth</h3>
                  <p class="text-gray-600 italic mb-3">Award Winning Innovation</p>
                  <p class="text-gray-800">
                     Built an AI-driven platform that earned <strong>"Best Canadian Focus"</strong> and <strong>"Best Use of Google Cloud"</strong> awards at Hackville. A testament to working under pressure and leveraging cloud tools for real-world impact.
                  </p>
               </div>

               <div class="p-6 bg-gray-50 rounded-xl border border-gray-100 hover:shadow-lg transition duration-300">
                  <h3 class="text-xl font-bold mb-2 text-pgreen">MediScope</h3>
                  <p class="text-gray-600 italic mb-3">Healthcare Impact</p>
                  <p class="text-gray-800">
                     Developed a comprehensive healthcare analytics system (ASP.NET Core & C#), showcasing full-stack capabilities and a deep interest in the intersection of technology and healthcare efficiency.
                  </p>
               </div>

               <div class="p-6 bg-gray-50 rounded-xl border border-gray-100 hover:shadow-lg transition duration-300">
                  <h3 class="text-xl font-bold mb-2 text-pyellow">Visual Impact</h3>
                  <p class="text-gray-600 italic mb-3">Data Storytelling</p>
                  <p class="text-gray-800">
                     Utilizing powerful tools like <strong>Chart.js</strong> to turn complex datasets into clear, visual stories. Visualization is key for decision-makers to understand the "why" behind the data.
                  </p>
               </div>

            </div>
        </section>

        <!-- Technical Arsenal -->
        <section class="grid md:grid-cols-12 gap-8 items-start">
            <div class="md:col-span-4">
               <h2 class="text-3xl font-bold border-b-4 border-pblue inline-block pb-2">Tech Stack</h2>
            </div>
            <div class="md:col-span-8">
               <div class="overflow-hidden rounded-xl border border-gray-200 shadow-sm">
                  <table class="w-full text-left border-collapse">
                     <thead class="bg-black text-white">
                        <tr>
                           <th class="px-6 py-4 font-semibold uppercase tracking-wider text-sm">Category</th>
                           <th class="px-6 py-4 font-semibold uppercase tracking-wider text-sm">Skills</th>
                        </tr>
                     </thead>
                     <tbody class="divide-y divide-gray-200 bg-white">
                        <tr class="hover:bg-gray-50 transition">
                           <td class="px-6 py-4 font-bold text-gray-900">Languages</td>
                           <td class="px-6 py-4 text-gray-700">Python, SQL, Java, C#, JavaScript, TypeScript</td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                           <td class="px-6 py-4 font-bold text-gray-900">Data & Viz</td>
                           <td class="px-6 py-4 text-gray-700">Data Analytics, Chart.js, Google Cloud, Matplotlib</td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                           <td class="px-6 py-4 font-bold text-gray-900">Frameworks</td>
                           <td class="px-6 py-4 text-gray-700">React, Astro, Next.js, Node.js, Flask, ASP.NET Core</td>
                        </tr>
                        <tr class="hover:bg-gray-50 transition">
                           <td class="px-6 py-4 font-bold text-gray-900">Interests</td>
                           <td class="px-6 py-4 text-gray-700">Fintech, Healthcare Tech, UX/UI</td>
                        </tr>
                     </tbody>
                  </table>
               </div>
            </div>
        </section>

        <!-- The Human Side -->
        <section class="grid md:grid-cols-12 gap-8 items-start">
            <div class="md:col-span-4">
               <h2 class="text-3xl font-bold border-b-4 border-pyellow inline-block pb-2">Human Side</h2>
            </div>
            <div class="md:col-span-8 space-y-6">
                <p class="text-lg text-gray-800">
                    Beyond the code, I believe in community and connection.
                </p>
                
                <div class="flex gap-4 items-start">
                    <div class="p-2 bg-pgreen/10 rounded-full text-pgreen mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold">Community Leadership</h4>
                        <p class="text-gray-700">Involvement with the <strong>Sheridan Tech Biz Society</strong> has honed my leadership skills, driving initiatives and collaborating effectively within a team.</p>
                    </div>
                </div>

                <div class="flex gap-4 items-start">
                    <div class="p-2 bg-pblue/10 rounded-full text-pblue mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold">Personal Interests</h4>
                        <p class="text-gray-700">When I'm not analyzing data, you can find me engaged in <strong>gaming</strong> or active in <strong>online forums</strong>. My comfort with digital communities makes me a natural fit for modern tech environments.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <div class="bg-black text-white rounded-2xl p-10 text-center shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-r from-ppink/20 to-pblue/20 opacity-0 group-hover:opacity-100 transition duration-500"></div>
            <h2 class="text-3xl font-bold mb-4 relative z-10">Let's Build Something Together</h2>
            <p class="text-xl mb-8 text-gray-300 relative z-10">I'm always looking for interesting projects in Fintech or Data Science.</p>
            <a href="/contact" class="inline-block bg-white text-black px-8 py-3 rounded-full font-bold shadow-lg hover:scale-105 active:scale-95 transition relative z-10">
                Contact Me
            </a>
        </div>

      </div>
    </main>

    <Footer />
  </body>
</html>
